# Copy to .env. Exported environment variables take precedence.

# Single repository containing <competition>/<year>.jsonl partitions.
# Optional when the selected files already exist in data/datasets/.
HF_DATASETS_REPO=notadib/DELVE-Datasets
HF_OUTPUTS_REPO=notadib/DELVE-Outputs
# Required for uploads; also used to read private datasets. Give access to these repos.
HF_TOKEN=

# Required endpoint for the existing OpenAI-compatible server.
VLLM_BASE_URL=http://localhost:8000/v1
# Optional: only needed if the server requires authentication.
# VLLM_API_KEY=
